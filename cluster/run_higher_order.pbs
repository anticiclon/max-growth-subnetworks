#!/bin/bash -l
# Redes de orden superior (sec:higher-order) en Euler (PBS Pro). Una tarea del array = una red.
# Envío desde la raíz del repositorio (crear antes la carpeta logs):
#   mkdir -p logs
#   qsub -J 0-99 cluster/run_higher_order.pbs
# Al terminar:  python3 experiments/exp_higher_order.py --aggregate
#PBS -N horder
#PBS -q RouteQ
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o logs/

set -eo pipefail          # sin -u: los scripts de "module" usan variables sin definir
cd "$PBS_O_WORKDIR"
module load python/3.12.8 gurobi/12.0.3
export GRB_LICENSE_FILE=/modules/apps/gurobi/gurobi1203/linux64/gurobi.lic
PY=python3

"$PY" experiments/exp_higher_order.py --task "$PBS_ARRAY_INDEX"
